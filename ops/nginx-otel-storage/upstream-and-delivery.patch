+// Record the real proxy call and propagate its span ID to the upstream.
+// This makes server-to-server hops visible to service maps that require a
+// client span between the two server spans.
+void addUpstreamSpans(ngx_http_request_t* r, OtelCtx* ctx, uint64_t endNs)
+{
+    auto upstream = r->upstream;
+    if (!ctx->upstream.spanId.IsValid() || !upstream || !upstream->state) {
+        return;
+    }
+    auto state = upstream->state;
+    auto peer = state->peer ? toStrView(*state->peer) : StrView{};
+    auto elapsedMs = ngx_current_msec - upstream->start_time;
+    auto elapsedNs = static_cast<uint64_t>(elapsedMs) * 1000000;
+    auto requestStartNs = (static_cast<uint64_t>(r->start_sec) * 1000 + r->start_msec) * 1000000;
+    auto startNs = endNs > elapsedNs ? endNs - elapsedNs : requestStartNs;
+    if (startNs < requestStartNs) startNs = requestStartNs;
+    if (startNs > endNs) startNs = endNs;
+    auto name = std::string("PROXY ") + std::string(getSpanName(r));
+    auto url = std::string(upstream->ssl ? "https://" : "http://") + std::string(peer) + std::string(toStrView(r->uri));
+    BatchExporter::SpanInfo proxyInfo{name, ctx->upstream, ctx->current.spanId, startNs, endNs};
+    gExporter->add(proxyInfo, [r, state, peer, &url](BatchExporter::Span& span) {
+        span.setClient();
+        span.add("http.method", toStrView(r->method_name));
+        if (!peer.empty()) span.add("http.url", url);
+        if (state->status) {
+            span.add("http.status_code", static_cast<int>(state->status));
+            if (state->status >= 500) span.setError();
+        }
+    });
+
+    // A second child measures the actual downstream response, separately from
+    // the proxy call. Only file GETs with a known upstream response qualify.
+    auto path = std::string(toStrView(r->uri));
+    if (r->method != NGX_HTTP_GET || path.rfind("/download/", 0) != 0 ||
+        !state->status || state->status < 200 || state->status >= 300) {
+        return;
+    }
+    auto headerMs = state->header_time;
+    if (headerMs == (ngx_msec_t)-1) return;
+    auto deliveryStart = startNs + static_cast<uint64_t>(headerMs) * 1000000;
+    if (deliveryStart > endNs) deliveryStart = endNs;
+    auto delivery = TraceContext::generate(true, ctx->current);
+    BatchExporter::SpanInfo deliveryInfo{"Send file to client", delivery,
+        ctx->current.spanId, deliveryStart, endNs};
+    gExporter->add(deliveryInfo, [r, &path](BatchExporter::Span& span) {
+        span.setInternal();
+        // Socket writes may still be buffered; they are not an application-level
+        // receipt from the remote client, especially after disconnects.
+        span.add("ow.transfer.scope", "nginx_to_client");
+        span.add("ow.transfer.measurement", "socket_bytes_written");
+        auto sent = r->connection->sent - static_cast<off_t>(r->header_size);
+        if (sent < 0) sent = 0;
+        auto expected = r->headers_out.content_length_n;
+        span.addInt64("ow.transfer.bytes_sent", static_cast<int64_t>(sent));
+        if (expected >= 0) {
+            span.addInt64("file.size", static_cast<int64_t>(expected));
+            if (expected > 0) {
+                auto percent = static_cast<double>(sent) * 100.0 / static_cast<double>(expected);
+                span.addDouble("ow.transfer.percent_sent", percent > 100.0 ? 100.0 : percent);
+            }
+            span.add("ow.transfer.result", sent >= expected ? "complete" : "interrupted");
+        } else {
+            span.add("ow.transfer.result", "unknown");
+        }
+        if (r->headers_out.content_type.len) {
+            span.add("http.response.mime_type", toStrView(r->headers_out.content_type));
+        }
+        std::vector<std::string> parts;
+        size_t pos = 1;
+        while (pos < path.size()) {
+            auto next = path.find('/', pos);
+            parts.push_back(path.substr(pos, next == std::string::npos ? next : next-pos));
+            if (next == std::string::npos) break;
+            pos = next + 1;
+        }
+        if (parts.size() < 3) return;
+        span.add("ow.storage.type", parts[1]);
+        auto filename = parts.back();
+        auto dot = filename.rfind('.');
+        if (dot == std::string::npos) return;
+        auto stem = filename.substr(0, dot);
+        auto ext = filename.substr(dot+1);
+        auto digits = [](const std::string& v) {
+            return !v.empty() && std::all_of(v.begin(), v.end(), [](unsigned char c) { return c >= '0' && c <= '9'; });
+        };
+        auto safe = [](const std::string& v) {
+            return !v.empty() && v.size() <= 64 && std::all_of(v.begin(), v.end(), [](unsigned char c) {
+                return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') ||
+                    (c >= 'A' && c <= 'Z') || c == '_' || c == '-';
+            });
+        };
+        if (safe(ext) && ext.size() <= 12) span.add("file.extension", ext);
+        if (parts.size() == 5 && digits(parts[3])) {
+            const char* kind = parts[2] == "mods" ? "mod" : parts[2] == "modpacks" ? "modpack" :
+                parts[2] == "games" ? "game" : parts[2] == "profiles" ? "user" : nullptr;
+            if (kind) {
+                span.add("ow.owner.type", kind);
+                span.add("ow.owner.id", parts[3]);
+                if (safe(stem)) span.add("ow.resource.id", stem);
+            }
+        } else if (parts.size() == 3 && parts[1] == "avatar" && digits(stem)) {
+            span.add("ow.owner.type", "user");
+            span.add("ow.owner.id", stem);
+        }
+    });
+}
