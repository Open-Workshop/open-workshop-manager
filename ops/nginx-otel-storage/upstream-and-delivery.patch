+OtelCtx* ensureOtelCtx(ngx_http_request_t* r)
+{
+    auto ctx = getOtelCtx(r);
+    if (ctx) {
+        return ctx;
+    }
+
+    ctx = createOtelCtx(r);
+    if (!ctx) {
+        return NULL;
+    }
+
+    auto lcf = getLocationConf(r);
+    if (lcf->traceContext & Propagation::Extract) {
+        ctx->parent = extract(r);
+    }
+
+    ctx->current = TraceContext::generate(false, ctx->parent);
+
+    return ctx;
+}
