+bool iremovePrefix(ngx_str_t* str, StrView p)
+{
+    if (str->len >= p.size() &&
+            ngx_strncasecmp(str->data, (u_char*)p.data(), p.size()) == 0) {
+        str->data += p.size();
+        str->len -= p.size();
