-template <class Id>
-ngx_int_t hexIdVar(ngx_http_request_t* r, ngx_http_variable_value_t* v,
-    uintptr_t data)
-{
-    auto ctx = ensureOtelCtx(r);
-    if (!ctx) {
-        return NGX_ERROR;
-    }
-
-    auto id = (Id*)((char*)ctx + data);
-
-    if (id->IsValid()) {
-        auto size = id->Id().size() * 2;
-        auto buf = (char*)ngx_pnalloc(r->pool, size);
-        if (buf == NULL) {
-            return NGX_ERROR;
-        }
-
-        id->ToLowerBase16({buf, size});
-
-        v->len = size;
-        v->valid = 1;
-        v->no_cacheable = 0;
-        v->not_found = 0;
-        v->data = (u_char*)buf;
-
-    } else {
-        v->not_found = 1;
-    }
-
-    return NGX_OK;
-}
